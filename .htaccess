# onoffmarketing rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTP → HTTPS (프록시로 이미 HTTPS면 루프 방지)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^robots\.txt$ /robots.php [L]
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # edu.icrm.co.kr — student platform at site root. Same tree, separate host.
  # Create data/EDU_HOST_LIVE after the vhost answers, to send /seo-system-300 here.
  RewriteCond %{HTTP_HOST} !^edu\.icrm\.co\.kr$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/data/EDU_HOST_LIVE -f
  RewriteRule ^seo-system-300/?(.*)$ https://edu.icrm.co.kr/$1 [R=302,L,QSA]

  RewriteCond %{HTTP_HOST} ^edu\.icrm\.co\.kr$ [NC]
  RewriteRule ^assets/(.*)$ edu/assets/$1 [END]

  RewriteCond %{HTTP_HOST} ^edu\.icrm\.co\.kr$ [NC]
  RewriteCond %{REQUEST_URI} !^/(plugin|api|bbs|adm|data|lib|theme|skin|install|shop|mobile|edu|js|img|css|extend)/
  RewriteRule ^ edu/index.html [END]

  # Soft-redirect classic GNUBoard member entry → branded AuthShell SPA
  # Must run BEFORE the existing-file pass-through (bbs/login.php is a real file).
  RewriteRule ^bbs/login\.php$ /login [L,R=302,QSA]
  RewriteRule ^bbs/register\.php$ /signup [L,R=302,QSA]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SEO SYSTEM 300 Control Center SPA (do not collide with /seo-system landing)
  RewriteRule ^seo-system-300(/.*)?$ /seo-system-300/index.html [QSA,L]

  # SEO SYSTEM 300 landing (static SPA). QSA keeps UTM query params.
  RewriteRule ^seo-system/?$ /seo-system/index.html [QSA,L]

  # Community boards (pretty URLs)
  RewriteRule ^notice/?$ /bbs/board.php?bo_table=notice&rewrite=1 [QSA,L]
  RewriteRule ^notice/write$ /bbs/write.php?bo_table=notice&rewrite=1 [QSA,L]
  RewriteRule ^notice/([0-9]+)$ /bbs/board.php?bo_table=notice&wr_id=$1&rewrite=1 [QSA,L]

  RewriteRule ^faq/?$ /bbs/board.php?bo_table=faq&rewrite=1 [QSA,L]
  RewriteRule ^faq/write$ /bbs/write.php?bo_table=faq&rewrite=1 [QSA,L]
  RewriteRule ^faq/([0-9]+)$ /bbs/board.php?bo_table=faq&wr_id=$1&rewrite=1 [QSA,L]

  RewriteRule ^youtube/?$ /bbs/board.php?bo_table=youtube&rewrite=1 [QSA,L]
  RewriteRule ^youtube/write$ /bbs/write.php?bo_table=youtube&rewrite=1 [QSA,L]
  RewriteRule ^youtube/([0-9]+)$ /bbs/board.php?bo_table=youtube&wr_id=$1&rewrite=1 [QSA,L]

  # BEGIN ONOFF BRANDED AUTH SPA ROUTES
  # Must stay BEFORE GNUBoard board catch-all ^([0-9a-zA-Z_]+)$
  RewriteRule ^(login|signup|session-expired)/?$ /index.php [L,QSA]
  RewriteRule ^password/forgot/?$ /index.php [L,QSA]
  RewriteRule ^auth/callback/?$ /index.php [L,QSA]
  RewriteRule ^account(/.*)?$ /index.php [L,QSA]
  # END ONOFF BRANDED AUTH SPA ROUTES

  # BEGIN ONOFF RENEWAL PRETTY ROUTES
  # Exact-match renewal SPA entry → index.php (home builder bridge renders SPA)
  RewriteRule ^education/classroom/?$ /index.php [L,QSA]
  RewriteRule ^(geo|domain|backlink|traffic|education)/?$ /index.php [L,QSA]
  # /content exact only — do NOT match /content/{co_id} (GNUBoard content)
  RewriteRule ^content/?$ /index.php [L,QSA]
  # END ONOFF RENEWAL PRETTY ROUTES

  #### GNUBOARD5 rewrite BEGIN #####
  RewriteRule ^content/([0-9a-zA-Z_]+)$ bbs/content.php?co_id=$1&rewrite=1 [QSA,L]
  RewriteRule ^content/([^/]+)/$ bbs/content.php?co_seo_title=$1&rewrite=1 [QSA,L]
  RewriteRule ^rss/([0-9a-zA-Z_]+)$ bbs/rss.php?bo_table=$1 [QSA,L]
  RewriteRule ^([0-9a-zA-Z_]+)$ bbs/board.php?bo_table=$1&rewrite=1 [QSA,L]
  RewriteRule ^([0-9a-zA-Z_]+)/([^/]+)/$ bbs/board.php?bo_table=$1&wr_seo_title=$2&rewrite=1 [QSA,L]
  RewriteRule ^([0-9a-zA-Z_]+)/write$ bbs/write.php?bo_table=$1&rewrite=1 [QSA,L]
  RewriteRule ^([0-9a-zA-Z_]+)/([0-9]+)$ bbs/board.php?bo_table=$1&wr_id=$2&rewrite=1 [QSA,L]
  #### GNUBOARD5 rewrite END #####
</IfModule>
